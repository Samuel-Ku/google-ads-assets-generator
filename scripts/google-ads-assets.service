[Unit]
Description=Google Ads Assets Studio
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/google-ads-assets/current
EnvironmentFile=/home/ubuntu/google-ads-assets/service.env
ExecStart=/home/ubuntu/google-ads-assets/venv/bin/python scripts/serve.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/google-ads-assets/data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
RestrictSUIDSGID=true
MemoryMax=1500M
TasksMax=64
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
